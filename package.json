{
  "name": "powder-help-me",
  "version": "1.0.0",
  "description": "PowderHelpMe.exe - Overlay et Dashboard de statistiques League of Legends style Powder (Arcane)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.powderhelpme.app",
    "productName": "PowderHelpMe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "league-of-legends",
    "overlay",
    "powder",
    "arcane",
    "dpm",
    "electron",
    "powder-help-me"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.8",
    "lucide": "^1.52.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
